---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
---

<Base lang="en" slug="" title={t('en', 'notfound.title')}>
  <section class="section center">
    <div class="container">
      <h1>{t('en', 'notfound.title')}</h1>
      <p class="lead">{t('en', 'notfound.body')} · {t('fr', 'notfound.body')}</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--ghost" href={getRelativeLocaleUrl('en', '')}>{t('en', 'notfound.home')}</a>
        <a class="btn btn--ghost" href={getRelativeLocaleUrl('fr', '')}>{t('fr', 'notfound.home')}</a>
      </div>
    </div>
  </section>
</Base>
